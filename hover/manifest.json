{
  "manifest_version": 3,
  "name": "Uudam Hover – Japanese Lookup",
  "short_name": "Uudam Hover",
  "version": "0.1.0",
  "description": "Hold Shift and point at Japanese text on any page to see the word's reading and English meaning.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uudam-hover@lobster2k25",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "vendor/kuromoji.js",
      "vendor/lookup.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
