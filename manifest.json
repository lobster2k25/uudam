{
  "manifest_version": 3,
  "name": "Uudam – Netflix Subtitles",
  "short_name": "Uudam",
  "version": "0.2.1",
  "description": "Japanese subtitles on Netflix and YouTube with furigana; click a word for its Mongolian meaning and kanji breakdown.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uudam@lobster2k25",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "vendor/kuromoji.js",
      "src/lookup.js",
      "src/dict-update.js",
      "src/background.js"
    ],
    "service_worker": "src/sw.js"
  },
  "host_permissions": [
    "*://www.netflix.com/*",
    "*://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://github.com/lobster2k25/mongol-dict/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.netflix.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.netflix.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/lookup.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/dict/*.json",
        "data/fallback.json"
      ],
      "matches": [
        "*://www.netflix.com/*",
        "*://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Uudam",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  }
}
